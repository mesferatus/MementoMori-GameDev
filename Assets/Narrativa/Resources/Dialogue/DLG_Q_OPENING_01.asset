  m_Script: {fileID: 11500000, guid: 8d1474fa99a3daa499fa16618548882f, type: 3}
  m_Name: DLG_Q_OPENING_01
  m_EditorClassIdentifier: MementoMori.Runtime::MementoMori.Dialogue.DialogueData
  sequenceId: DLG_Q_OPENING_01
  lines:
  - Text: "...N\xE3o. N\xE3o era para terminar assim."
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: Eu fiz o ritual. Tenho certeza de que fiz.
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: O que aconteceu depois?
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Minha cama. Meu grim\xF3rio. Mas essa janela..."
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Esse n\xE3o \xE9 o meu quarto."
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: O que eu esqueci?
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  conditions: []
