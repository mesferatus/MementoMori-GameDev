  m_Name: DLG_MOON_DOMAIN_GATE
  m_EditorClassIdentifier: MementoMori.Runtime::MementoMori.Dialogue.DialogueData
  sequenceId: DLG_MOON_DOMAIN_GATE
  lines:
  - Text: "Voc\xEA est\xE1 me levando at\xE9 l\xE1."
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Ou eu estou seguindo porque preciso acreditar que reconhe\xE7o voc\xEA."
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: A primeira porta sempre parece chegada.
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "E n\xE3o \xE9?"
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Voc\xEA ainda est\xE1 pensando em lugares."
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Bem-vinda \xE0 nega\xE7\xE3o."
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  conditions: []
