MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8d1474fa99a3daa499fa16618548882f, type: 3}
  m_Name: DLG_ANDREALPHUS_01
  m_EditorClassIdentifier: MementoMori.Runtime::MementoMori.Dialogue.DialogueData
  sequenceId: DLG_ANDREALPHUS_01
  lines:
  - Text: "Ela finalmente trouxe o sil\xEAncio consigo."
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Quem \xE9 voc\xEA?"
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Uma pergunta muito s\xF3lida para este lugar."
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Voc\xEA sabe meu nome."
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Voc\xEA tamb\xE9m sabe o dele."
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: E ainda assim hesitou.
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Aquilo pode n\xE3o ser Poe."
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: Pode?
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: Que palavra misericordiosa.
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: Onde estou?
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Entre uma inten\xE7\xE3o e a coragem de admitir qual era."
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Isso n\xE3o responde."
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Respostas s\xE3o portas muito confiantes."
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: Aqui, as confiantes costumam levar ao mesmo lugar.
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: Quero sair.
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: Naturalmente.
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Todos chamam de sa\xEDda a dire\xE7\xE3o em que ainda n\xE3o sofreram."
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "E voc\xEA pretende impedir?"
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "N\xE3o."
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Pretendo observar qual de voc\xEAs duas chega primeiro."
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: Duas?
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  conditions: []
