MonoBehaviour:
  m_Script: {fileID: 11500000, guid: 8d1474fa99a3daa499fa16618548882f, type: 3}
  m_Name: DLG_L_ECHO_COMPLETE
  m_EditorClassIdentifier: MementoMori.Runtime::MementoMori.Dialogue.DialogueData
  sequenceId: DLG_L_ECHO_COMPLETE
  lines:
  - {Text: "O Labirinto não quer que eu lembre.", Speaker: "Melantha", CharactersPerSecond: 38, PauseBefore: 0, PauseAfter: 0, Thought: 0, Narration: 0, LockMovement: 1}
  - {Text: "Quer que eu pare de escolher a lembrança mais confortável.", Speaker: "Melantha", CharactersPerSecond: 38, PauseBefore: 0, PauseAfter: 0, Thought: 0, Narration: 0, LockMovement: 1}
  - {Text: "Ótimo.", Speaker: "Melantha", CharactersPerSecond: 38, PauseBefore: 0, PauseAfter: 0, Thought: 0, Narration: 0, LockMovement: 1}
  - {Text: "Eu sempre quis terapia com arquitetura hostil.", Speaker: "Melantha", CharactersPerSecond: 38, PauseBefore: 0, PauseAfter: 0, Thought: 0, Narration: 0, LockMovement: 1}
  conditions: []
