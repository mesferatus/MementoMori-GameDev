--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8d1474fa99a3daa499fa16618548882f, type: 3}
  m_Name: DLG_ANDREALPHUS_02
  m_EditorClassIdentifier: MementoMori.Runtime::MementoMori.Dialogue.DialogueData
  sequenceId: DLG_ANDREALPHUS_02
  lines:
  - Text: "Voc\xEA escolheu muito bem."
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "N\xE3o confio em elogios vindos de um espelho."
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: Nem deveria.
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: Eles costumam admirar apenas o que conseguem inverter.
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Voc\xEA sabia que eu viria."
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Saber \xE9 uma palavra que as pessoas usam quando esquecem quantas vezes
      tentaram."
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "J\xE1 estive aqui?"
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Voc\xEA trouxe partes de si."
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: Algumas chegaram antes.
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: O que este lugar quer?
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Lugares n\xE3o querem."
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Mas inten\xE7\xF5es, quando abandonadas, tornam-se p\xE9ssimas em aceitar
      o fim."
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: O ritual.
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: Qual deles?
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: Pare de responder com perguntas.
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Pare de fazer perguntas cujas respostas j\xE1 desenhou no ch\xE3o."
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Poe est\xE1 morto."
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Essa \xE9 a frase mais verdadeira que voc\xEA disse."
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "N\xE3o \xE9 a \xFAnica verdade dispon\xEDvel."
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Ele est\xE1 aqui?"
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Voc\xEA ainda pergunta como se \u2018aqui\u2019 fosse um lugar."
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: Entre, Melantha.
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: A Lua prefere pessoas que confundem reconhecimento com certeza.
    Speaker: Andrealphus
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  conditions: []
