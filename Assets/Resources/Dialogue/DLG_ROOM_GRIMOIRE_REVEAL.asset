  sequenceId: DLG_ROOM_GRIMOIRE_REVEAL
  lines:
  - Text: "MEM\xD3RIA N\xC3O \xC9 ALMA."
    Speaker: "Narra\xE7\xE3o"
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "FORMA N\xC3O \xC9 PRESEN\xC7A."
    Speaker: "Narra\xE7\xE3o"
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: UM NOME ABRE.
    Speaker: "Narra\xE7\xE3o"
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "UM V\xCDNCULO SUSTENTA."
    Speaker: "Narra\xE7\xE3o"
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "UM PRE\xC7O FECHA."
    Speaker: "Narra\xE7\xE3o"
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Um nome abre. Um v\xEDnculo sustenta. Um pre\xE7o fecha."
    Speaker: "Narra\xE7\xE3o"
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Um pre\xE7o fecha."
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
    LockMovement: 1
  - Text: "Eu n\xE3o escrevi essa linha."
    Speaker: Melantha
    CharactersPerSecond: 38
    PauseBefore: 0
    PauseAfter: 0
    Thought: 0
    Narration: 0
