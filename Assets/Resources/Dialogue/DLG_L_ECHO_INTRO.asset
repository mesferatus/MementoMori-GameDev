  sequenceId: DLG_L_ECHO_INTRO
  lines:
  - {Text: "Uma pergunta antes do vocabulário.", Speaker: "Melantha", CharactersPerSecond: 38, PauseBefore: 0, PauseAfter: 0, Thought: 0, Narration: 0, LockMovement: 1}
  - {Text: "O poço disse que este lugar corrige.", Speaker: "Melantha", CharactersPerSecond: 38, PauseBefore: 0, PauseAfter: 0, Thought: 0, Narration: 0, LockMovement: 1}
  - {Text: "Então eu procuro a voz que muda.", Speaker: "Melantha", CharactersPerSecond: 38, PauseBefore: 0, PauseAfter: 0, Thought: 0, Narration: 0, LockMovement: 1}
